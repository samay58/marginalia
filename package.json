{
  "name": "tauri-app",
  "version": "0.2.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check:diff": "node scripts/check-diff-id-retention.mjs",
    "check:annotations": "node scripts/check-annotations.mjs",
    "check:targets": "node scripts/check-review-targets.mjs",
    "check:plain": "node scripts/check-plain-text-baseline.mjs",
    "check:render": "node scripts/check-diff-render-state.mjs",
    "check:tokens": "node scripts/check-css-tokens.mjs",
    "check:semantic": "node scripts/check-semantic-diff.mjs",
    "check:bundle": "node scripts/check-bundle-artifacts.mjs",
    "check:hook": "bash scripts/check-hook-async-queue.sh",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "tauri": "tauri",
    "tauri:build:app": "tauri build --bundles app",
    "tauri:build:dmg": "tauri build --bundles dmg",
    "verify": "pnpm run -s check:diff && pnpm run -s check:annotations && pnpm run -s check:targets && pnpm run -s check:plain && pnpm run -s check:render && pnpm run -s check:tokens && pnpm run -s check:semantic && pnpm run -s check:bundle && pnpm run -s check:hook && pnpm run -s check && pnpm run -s build"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@milkdown/core": "^7.18.0",
    "@milkdown/ctx": "^7.18.0",
    "@milkdown/plugin-listener": "^7.18.0",
    "@milkdown/preset-commonmark": "^7.18.0",
    "@milkdown/prose": "^7.18.0",
    "@milkdown/utils": "^7.18.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "diff-match-patch": "^1.0.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
